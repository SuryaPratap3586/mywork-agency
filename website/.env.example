# PUBLIC WEBSITE. Copy to .env.local and fill in. NEVER commit .env.local.

# Your public address (sitemap, canonical URLs, sharing)
SITE_URL=http://localhost:3000

# Supabase (server-side only: the service role key must never reach the browser)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret that lets your admin app refresh this site instantly after you publish.
# Use the SAME value in the admin app. Generate one:  openssl rand -base64 32
REVALIDATE_SECRET=
